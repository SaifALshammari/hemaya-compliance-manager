{
  "name": "MappingReview",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string",
      "description": "Reference to the policy"
    },
    "control_id": {
      "type": "string",
      "description": "Control identifier"
    },
    "framework": {
      "type": "string",
      "enum": [
        "NCA ECC",
        "ISO 27001",
        "NIST 800-53"
      ],
      "description": "Compliance framework"
    },
    "evidence_snippet": {
      "type": "string",
      "description": "Policy text snippet used as evidence"
    },
    "confidence_score": {
      "type": "number",
      "description": "AI confidence score (0-1)"
    },
    "decision": {
      "type": "string",
      "enum": [
        "Pending",
        "Accepted",
        "Rejected",
        "Modified"
      ],
      "default": "Pending",
      "description": "Human reviewer decision"
    },
    "reviewer": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "review_notes": {
      "type": "string",
      "description": "Notes from the reviewer"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of review"
    },
    "ai_rationale": {
      "type": "string",
      "description": "AI explanation for the mapping"
    }
  },
  "required": [
    "policy_id",
    "control_id",
    "framework"
  ]
}